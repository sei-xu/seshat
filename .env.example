# Seshat MCP Server Configuration
# Copy this file to .env and fill in the values

# API key for server authentication (Bearer token)
# Generate a secure random key, e.g.: openssl rand -hex 32
SESHAT_API_KEY=your-secure-api-key-here

# Git remote URL for vault synchronization
# This is the upstream vault repository where changes are pushed
SESHAT_GIT_REMOTE=https://github.com/username/vault.git

# Vault root directory
# On local: relative path to vault root
# On Render: /var/data/vault (persistent disk)
SESHAT_VAULT_ROOT=./vault

# Server host (default: 127.0.0.1)
# Set to 0.0.0.0 for production/cloud deployment
SESHAT_HOST=0.0.0.0

# Server port (default: 8000)
SESHAT_PORT=8000

# Git configuration for commits
SESHAT_GIT_USER_NAME=Seshat
SESHAT_GIT_USER_EMAIL=seshat@seîxu.local
